# Configuration Backend E-Dépôt (Spring Boot 3.2.3)
SERVER_PORT=8080

# Base de Données PostgreSQL
# Par défaut, le backend utilise la persistance H2 compatible PostgreSQL (./data/edepot_db)
# Pour basculer sur un serveur PostgreSQL dédié :
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/edepot
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Sécurité & JWT (Clé secrète minimum 256 bits)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Initialisation Administrateur Racine (CommandLineRunner)
ADMIN_EMAIL=admin@edepot.sn
ADMIN_INITIAL_PASSWORD=Admin2025!
ADMIN_NOM=Directeur E-Dépôt
ADMIN_TELEPHONE=+221770000000
